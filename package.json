    "@supabase/supabase-js": "^2.49.4",
    "framer-motion": "^14.6.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.61.0",
    "next": "^15.5.28",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
