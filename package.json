  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "portal": "node --env-file-if-exists=.env.local scripts/supabase-admin.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
