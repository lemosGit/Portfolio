# Copie para .env.local e preencha. Sem as duas primeiras, o portal usa dados de exemplo.

# Supabase → Project Settings → API (ou "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Painel /admin (servidor) e script `npm run portal`. Na Vercel: tipo Secret, SEM prefixo NEXT_PUBLIC_. Nunca no Git.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
ADMIN_EMAIL=o-seu-email@exemplo.com

# Vercel → Settings → Environment Variables (protege /api/keepalive)
CRON_SECRET=uma-frase-longa-e-aleatoria

# GitHub → Settings → Developer settings → Fine-grained tokens
# Repository access: só os repositórios dos clientes · Permissions: Issues (Read) + Metadata (Read)
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxx
# Segredo partilhado com o webhook de cada repositório (/api/github/webhook)
GITHUB_WEBHOOK_SECRET=outra-frase-longa-e-aleatoria
# Opcional, só local: mostra as fases reais deste repositório no modo de demonstração
# PORTAL_DEMO_REPO=lemosGit/candongueiro_pay

# Avisos por email ao cliente (Resend). Sem a chave, o portal funciona e não envia emails.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=JP Studio <portal@joao-pereira.dev>
